# Telegram Bot Token from @BotFather (required)
BOT_TOKEN=

# Optional comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to let anyone (you + friends) use it, or list IDs like: 123456789,987654321
ALLOWED_USER_IDS=

# SQLite database path (inside container use /app/data/bot.db)
DB_PATH=data/bot.db

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Free AI Layer with Automatic Failover (OpenAI-compatible API) ---
# Leave both API keys empty to run in pure deterministic rule-based mode.
#
# Primary LLM (recommended: Groq Free Tier — 30 RPM / 1000 RPD, strict per-account buckets)
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional Fallback LLM (automatically called if Primary hits 429/503/timeout)
# Recommended: Cerebras (~1M free tokens/day) or Google Gemini OpenAI endpoint
#   Cerebras:
#     LLM_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
#     LLM_FALLBACK_MODEL=gpt-oss-120b
#   Google AI Studio (Gemini):
#     LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_FALLBACK_MODEL=gemini-4-hydrogen
#   Local Ollama:
#     LLM_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
#     LLM_FALLBACK_MODEL=llama3.2
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
LLM_FALLBACK_MODEL=gpt-oss-120b

LLM_TIMEOUT_SECONDS=15
